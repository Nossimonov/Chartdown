(* ===================================================================
   Chartdown consolidated grammar — spec v0.6 (sections 01–08)
   Status: informative consolidation; the prose spec sections are
   normative and win on any conflict. Maintained per issue #12:
   a spec change updates this file in the same commit WHEN
   THE GRAMMAR CHANGED — 29 of 59 spec commits rightly did not (#335).
   Lexical fine print (whitespace, string escapes, INDENT) is defined
   in prose (spec 01); semantic rules (resolution order, fail-loud
   references, GM stripping) are prose-only and noted as comments.
   =================================================================== *)

(* ---- document skeleton — spec 01 ---- *)

document       = [ title ] , header , { section } ;
                 (* pure-vocabulary library documents may omit the header
                    entirely (only [vocab] sections) — spec 04 §2 *)
title          = "#" , text , EOL ;                  (* first non-blank line only *)
header         = ( map-line | kind-line ) , { header-line } ;
                 (* the first header line is map: or kind:, never both — spec 01 §2 *)
map-line       = "map" , ":" , map-type , EOL ;
kind-line      = "kind" , ":" , document-kind , EOL ;
document-kind  = "vocabulary" | "theme" ;
map-type       = "battlemap" | "hexcrawl" | "region" ;
                 (* experimental types carry a -beta suffix *)
header-line    = header-key , ":" , predicate , EOL ;
header-key     = "ground" | "chartdown" | "id" | "grid" | "scale" | "extent" | "seed"
               | "detail"
               | "use" | "theme" | "labels" | "legend" | "scale-bar"
               | "compass" | "numbers" | "levels" | "level" | "inset" ;
                 (* "use" is repeatable; unknown keys warn.
                    inset = doc-path , "at" , ref — the child half of a
                    sub-map seam, validated against the parent (#143). 
                    levels: physical order topmost first; level: the default.
                    Values are unconstrained HERE, but five keys carry closed
                    value sets checked semantically (spec 01 §2):
                      labels    = "names" | "keyed" | "none" ;
                      detail    = "overview" | "reference" ;
                      legend | scale-bar | compass | numbers = "on" | "off" ;
                    plus map-line/kind-line above. Out-of-set = error, never a
                    silent default.
                    Four more carry FORMATS, likewise checked (spec 01 §2):
                      extent = number , "x" , number , [ unit ] ;
                      seed   = [ "-" ] , digit , { digit } ;
                      scale  = measure ;   (* unit optional, per `measure` below *)
                      chartdown = number , { "." , number } ;
                    Malformed = error, never a silent fallback. *)

section        = "[" , section-name , [ " " , word ] , "]" , EOL , { content-line } ;
section-name   = word ;                              (* known names per map type, spec 05/06/07;
                                                        universal: vocab, gm, labels;
                                                        x- prefix = silent extension namespace;
                                                        otherwise unknown warns.
                                                        optional qualifier token = level (spec 06 §8) *)
content-line   = line | detail-line | hex-ledger-line | vocab-line | label-line ;
line           = subject , ":" , predicate , EOL ;
detail-line    = INDENT , line ;                     (* structure details only — spec 06 §3.
                                                        subject kinds: opening, wall-state,
                                                        or a BARRIER word replacing that side
                                                        (#130) — predicate = side words or
                                                        edge tokens in all three cases. *)

subject        = [ type-word ] , { id-word } , [ string ] ;
                 (* sections may permit omitting the type word (spec 01 §4);
                    identity/uniqueness rules: spec 03 §1 *)
type-word      = word - archetype ;
                 (* an archetype name is GRAMMAR, legal only on the right-hand
                    side of a vocab-line: writing one here is an ERROR naming
                    the fix (spec 04 §1, ADR 0039, #266) *)
predicate      = { token } ;
token          = placement | word | string | pair ;
pair           = key , "=" , ( word | string | measure | level-span ) ;
level-span     = level-name , [ ".." , level-name ] ;
                 (* `to=`/`through=` accept a RANGE (spec 06 §8, #112):
                    to=a..b lands on every level between; through=a..b is
                    occupied but not opened onto and requires a to=.
                    The ANNOTATION is a property of the FLIGHT, not of the
                    panel that drew it (06 §8, ADR 0048, #321): the landings
                    are the to= range PLUS the declaring level MINUS the
                    through= range, and each panel names the NEAREST of them
                    in levels: order — ties to the level ABOVE. This binds the
                    RECIPROCAL panels too; naming the declaring level there,
                    or printing a range verbatim, is NON-CONFORMING. *)
comment        = ";" , text , EOL ;                  (* legal at end of any line; ";" in strings is content *)

(* ---- placements — spec 02 ---- *)

placement      = address | range | edge | point | point-range | shape | relational
               | repeat ;
repeat         = ( "every" , step , "in" , range )
               | ( "every" , measure , "along" , ref ) ;
step           = number , [ "x" , number ] ;
                 (* a QUALIFIER, not a relational form — spec 02 §9.
                    Expands at parse time to one address per stepped cell,
                    offsets measured from the range NW corner; >4096 = error.
                    the `along` form spaces by MEASURE down a resolved
                    course — expanded once the reference is in hand (#140). *)
address        = col-letters , row-number ;          (* chess-style, all grid types; AA past Z *)
                 (* AND ONLY ON A GRID. A gridless map declares no `grid:`,
                    so an address, a range or an edge token in a PLACEMENT
                    names nothing there and is an ERROR at the line that
                    wrote it -- bare, under "at", under "on"'s "at"
                    payload, in a course's "via" controls, in a shape's
                    argument list, and in a [labels] override's "at" or
                    "sprawl" target. The message names the point form.
                    Refused rather than approximated, as §5 refuses a
                    corner: reading C4 as world units substitutes an
                    address form the author did not write. Every spelling
                    used to render byte-identically to its own absence and
                    `area C4..D5` emitted an empty point list -- an entity
                    that resolves to NO GEOMETRY contributes no element.
                    `grid:` on a gridless map WARNS instead (the map draws
                    correctly without it) and does not rescue the address.
                    Spec 02 §1/§2/§6, ADR 0049, #325 *)
range          = address , ".." , address ;
point          = "(" , number , "," , number , ")" ; (* gridless world units, origin NW *)
control        = point , [ "@" , measure ] ;
                 (* a centerline control, optionally stating the channel's
                    WIDTH there — spec 05 §4, ADR 0030, #190. That width is the
                    CROSS-SECTION SQUARE TO THE CENTERLINE (ADR 0033, #192):
                    the distance between the rails, which is what a renderer
                    draws — not the largest circle that fits, which inflates at
                    a bend, and not the narrowest crossing in any direction,
                    which is the reading a MOUTH takes. `size=` is the
                    profile's first point; an omitted width is interpolated;
                    where widths are stated they are the shape and `taper=`
                    governs only the generated case.
                    HOW MANY controls state a line does not change the line
                    (#189): their spacing is not part of the shape, so a
                    measured centerline and a sketched one describing the same
                    curve draw the same. *)
point-range    = point , ".." , point ;
edge           = address , "." , dir ;               (* O6.s edges: n e s w ; K5.nw corners: ne nw se sw.
                    an EDGE places a wall, door or window -- a barrier, an
                    opening, or a structure detail naming one; elsewhere it
                    is an error. a CORNER is consumed by nothing and is an
                    error wherever written, reserved for a future proposal
                    (spec 02 5, ADR 0043, #281) *)
shape          = ( "area" | "path" | "blob" | "ridge" ) ,
                 [ "on" , ref , "at" ] , { placement | pair } ;
                 (* `raw` flag on an area = literal edges; without it a
                    TERRAIN area outline is organically finished (spec 02 §9,
                    #96). Water areas and `along`-spliced outlines are literal.
                    a battlemap `path` names only its CORNERS and is drawn
                    through cell centres — the drawn band spans its TERMINAL
                    cells rather than stopping at their middles, along the
                    direction of travel (spec 06 §6, #145). The declared spine
                    is unchanged; this is where the ink stops.
                    On a BATTLEMAP these shape forms are TERRAIN's: a feature
                    placed with one is an error, its footprint being a cell or
                    a range (spec 06 §2, #207). On a REGION map an `area` on a
                    feature is a declared outline (spec 05 §4, ADR 0026).
                    with `on <ref> at`, the points are OFFSETS in the
                    referent's frame and the WHOLE shape moves with it —
                    spec 02 §9, #142. Anchoring one point deforms the shape. *)
                 (* inside an "area" point list, "along" , ref between two
                    vertices makes the boundary follow the feature's curve
                    between their projections — spec 05 §2, ADR 0012 *)

                 (* ON A GRID, spec 06 §6 lists which of these forms resolve
                    and which are REPORTED. A form that states a relation but
                    no square — near, <measure> <compass> of, <compass> edge
                    of, a bare "on", a lone along — is ambiguous under §7 and
                    fails loud; it is never silently dropped (#239). *)
relational     = ( "at" , ( point | address | range | edge ) )
                 (* "at" is OPTIONAL on grids (spec 02 §7), so `at F6` and
                    `F6` are one placement and cannot differ. *)
               | ( [ measure ] , compass , "of" , ref )
                 (* the HALF-PLANE: terrain on the far side of ref's course.
                    Means the SAME THING on every map kind — spec 05 §2 for a
                    region, spec 06 §6 for a battlemap, where it resolves in
                    cell space: ink to ref's CENTERLINE, a cell covered when
                    its CENTRE lies strictly beyond the course, ties to ref.
                    ADR 0038 reversed the battlemap prohibition, #231. *)
               | ( "on" , ref , [ "at" , ( point | address | range | edge ) ] ,
                   [ "via" , control , { control } ] )
                 (* "via" after an "at" point declares a PLACED FEATURE's
                    centerline — spec 05 §4, #169. A bite is one straight run
                    without it, and Hood Canal turns hard east at the Great
                    Bend. One mouth and one head, so this is not the
                    line-BRANCHING that 05 §4 stages.
                    It replaces reach= for DEPTH and for DIRECTION both (#175):
                    the side the feature runs to is the author's, and the
                    water's side governs only a generated run.
                    A centerline MUST leave its host PERPENDICULAR, and a
                    departure too skewed for a squared first control to rescue
                    is reported as the skew with both bearings rather than as a
                    fold — spec 05 §4, #183, #194.
                    Where `ref` is another jut/bite the feature is an ARM, and
                    its "at" point may not lie on that host's own centerline —
                    the side is a direction TOWARD that line, so on it there is
                    none and the document has not said which bank. Refused,
                    never picked — spec 05 §4, ADR 0031, #191. *)
               | ( compass , "edge" , "of" , ref )
               | ( "near" , ( ref | point ) )
               | ( "from" , endpoint , [ "via" , via-control , { via-control } ] ,
                   ( ( "to" , endpoint ) | ( "join" , ref ) ) )
               | ( "along" , [ compass , "edge" , "of" ] , ref ) ;
                 (* closed grammar — no other relational forms exist.
                    multiple relational placements constrain jointly; two "on"
                    path refs = band intersection (crossings, spec 06 §6).
                    "on <ref> at <address|range|edge>" is LOCAL to the
                    referent's frame (structure footprint, NW = A1; a path's
                    frame is the document grid) — spec 02 §7, issue #34.
                    detail lines: "at"-prefixed placement = parent frame.
                    resolution: order-bounded, deterministic (seeded),
                    fail-loud, live anchors — spec 02 §8 *)
endpoint       = ( ref , [ "at" , point ] ) | point ;
ref            = word | string ;                     (* word: explicit-id lookup; string: display-name
                                                        lookup; fail-loud — spec 03 §2 *)
doc-path       = word | string ;                     (* a file reference — `detail=` and `inset:`. NOT `use:`,
                                                        which still reads its whole header value as the key
                                                        and is left inconsistent on purpose (#324).
                                                        QUOTING IS HOW A PATH HOLDS A SPACE, and the
                                                        quotes DELIMIT it rather than belong to it:
                                                        "The Chipped Tankard.md" and an unspaced bare
                                                        path resolve alike, which is what lets the two
                                                        ends of a seam be compared. An unquoted path
                                                        containing a space is an ERROR — `at` is the
                                                        separator, so `inset: The Parent.cd at tavern`
                                                        cannot be split without guessing.
                                                        Spec 03 §4, ADR 0047, #323/#324 *)
(* A course's SHAPE control. A world point anywhere; a CELL on a grid, where
   every other position is written that way (#258). A gridless point on a grid
   map is REPORTED, never rounded to a cell: cell size follows `scale:`, so the
   same (60,40) would name a different square after a scale edit. The converse
   -- a CELL on a gridless map -- is refused by the general rule on `address`
   above, which is where it now lives: the region renderer used to refuse it
   HERE and in no other slot, which is what left the other six silent
   (ADR 0049, #325). *)
via-control    = point | address ;

compass        = "n" | "s" | "e" | "w" | "ne" | "nw" | "se" | "sw"
               | "north" | "south" | "east" | "west"
               | "northeast" | "northwest" | "southeast" | "southwest" ;
measure        = number , [ unit ] ;                 (* 70mi, 20ft, 12 — unit dimension must match map *)

(* ---- hex ledger shorthand, [hexes] only — spec 05 §3 ---- *)

hex-ledger-line = ( address | range ) , terrain-word , { content-word } ,
                  [ string ] , { word | pair } , EOL ;
                  (* first vocab word = hex terrain; subsequent = contents;
                     params include seen / unexplored / gm= ;
                     grouped alternative: ordinary line form "forest : C4 D3 D4" *)

(* ---- vocabulary, [vocab] sections and use: libraries — spec 04 ---- *)

vocab-line     = type-word , ":" , ( archetype | word ) , { pair | word } , EOL ;
                 (* second form = derivation from another word, with overrides;
                    cycles are errors; shadowing order: stdlib < use: < document.
                    the DEFINED word is a type-word, so a document may not
                    shadow an archetype name (ADR 0039, #266) *)
archetype      = "terrain" | "path" | "feature" | "structure" | "barrier"
               | "opening" | "token" | "zone" | "field" ;
                 (* closed; extensible by spec sections only.
                    unknown words never fail: archetype inferred from
                    shape token, else section, else feature — spec 04 §3.
                    the nine names themselves are the exception: reserved in
                    the type-word position, refused rather than inferred *)

(* ---- themes, [theme]/[glyphs] sections — spec 08 ----
   theme documents contain only these sections; no map: header required. *)

theme-line     = theme-subject , ":" , { pair } , EOL ;
theme-subject  = word , [ "." , word ]                (* word / word.state / word.core / word.edge *)
               | "side" , "." , word
               | surface-word ;
surface-word   = "paper" | "grid" | "fog" | "ink" | "light" | "ledge"
               | "leader" ;
                 (* pair keys (closed): fill stroke width dash opacity glyph
                    asset edge bank;
                    bank = "land" | "water" | "both" — which side of its own
                    line a border's ink lies on, clipped to that region. Never
                    centred: that is the ambiguity that loses narrow channels.
                    Spec 08 §3, ADR 0034, #185;
                    there is deliberately NO pair for the LEGIBILITY FLOOR
                    (spec 05 §2, ADR 0035), which draws a sub-floor channel as
                    a symbol: a floor a theme could lower is not a floor;
                    ink is in CANVAS units and geometry is in MAP units
                    (spec 02 §9, ADR 0037): these pairs are ink, so they scale
                    with extent: on purpose, while no shape may;
                    glyph= and asset= values may be comma-separated variant pools,
                    chosen by deterministic position hash *)
glyph-line     = word , ":" , string , EOL ;          (* SVG path data, 24x24 box centered on origin *)

(* ---- labels, [labels] section — spec 07 ---- *)

label-line     = ( ref , ":" , label-hint )          (* override — subject MUST resolve *)
               | ( "note" , [ id-word ] , string , ":" , placement , { word | pair } ) ;
label-hint     = ( "sprawl" , ( range | point-range ) )
               | ( "along" , ref )
               | ( "at" , ( point | address ) )
               | compass ;

(* ---- reserved generic parameters and flags (usable on any content line) ----
   flags:  hidden, nolabel, difficult, seen, unexplored, ruined, overturned (state flags per vocab),
           drop (fall-edge boundary, spec 06 §5), open (unroofed structure, spec 06 §3)
   pairs:  gm=, link=, detail=, detail-at=, facing=, size=, side=, width=, light=,
           elevation=, key=, level=, to=, through=, at=
   A key OUTSIDE this set must be one the word can consume — a facet it
   declares or inherits, one its ARCHETYPE gives it whether or not the word
   states a default (spec 04 §1's table: passes=/sight= on barrier and opening,
   occluded= on field, width= on path, facing= on feature, size=/side= on token;
   plus reach=/taper= on placed morphology), or a declared field's name — else
   it WARNS (spec 04 §2, #195, #267).
   `x-` prefixed pairs are the silent extension namespace, as [x-*] sections are.
   An AMBIENT baseline (`light: dark` and friends) is drawn only on a
   battlemap; a region or hexcrawl WARNS and renders without it -- at those
   scales visibility is tactical (spec 04 5, #287). The regional override
   works on every map kind.
   A field's DRAWING (ambient wash, emitter pool, the pool's cut-out) is clipped
   to the map field of its own panel -- the frame inset by its margin, never the
   page furniture (spec 04 5, ADR 0042, #284/#288). The declared range is
   unaffected and exports at its true value.
   A pool that FILLS its whole field is REPORTED, not redrawn (spec 04 5,
   ADR 0050, #290): a 60ft lantern in a 15ft room leaves no ambient visible,
   which is faithful, so the renderer changes nothing and WARNS instead,
   naming the emitter. Per panel, like the clip.
   [gm] semantics (spec 03 §5): resolving subject = attachment (no placement allowed);
   non-resolving subject with placement = new GM-only entity; otherwise error.
   `hidden` and [gm] decide what a READER is shown, not what the document SAYS,
   so spec 06 10's coherence lints read the DECLARED model and a document
   produces the SAME lints in gm and player mode -- a lint set that varies with
   the render mode is non-conforming (spec 06 10, ADR 0045, #320). What is
   DRAWN is still the redaction; this governs only what is REASONED ABOUT.
   The reciprocal landing (spec 06 8) reads BOTH sets, and which side takes
   which is normative (ADR 0046, #319): the SOURCE -- does a connector on
   another level project a landing here -- is the DRAWN model, so a hidden
   connector projects nothing anywhere; the GUARD -- is a connector DECLARED at
   the cell it would land on -- is the DECLARED model, filtered to that panel's
   level. Testing the drawn set on BOTH sides is non-conforming: the strip
   removed the secret and the projection wrote it straight back. Each panel is
   governed by the end declared ON it, which is how a double declaration spells
   a ONE-SIDED secret -- hidden above, plain below. *)

(* ---- identity and anchors — spec 03 ----
   entity-id = explicit id, else display-name slug; anonymous entities unreferenceable.
   exported anchor: "cd-" doc-id "-" entity-id ; doc-id from id: header else title slug. *)
