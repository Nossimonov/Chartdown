# The Gilded Tankard — Ink and Vellum
; The travelling theme, plus this document's own word.
kind: theme
use: ../ink-and-vellum.theme.cd

[theme]
; `hearth : campfire` is this document's own derivation (spec 04 §3). It is the
; common room's light as well as its furniture, so it gets its own mark rather
; than the travelling theme's generic prop.
hearth : glyph=hearth-fire

[glyphs]
hearth-fire : "M-9,8 L-9,-4 L9,-4 L9,8 M-9,8 L9,8 M0,6 C-4,2 -3,-1 0,-3 C3,-1 4,2 0,6"
